# Application
APP_NAME=go-askar
PORT=8080
GIN_MODE=debug

# Database (SQLite - Default)
DB_DRIVER=sqlite
DB_PATH=storage/database/app.db

# PostgreSQL Configuration (Uncomment to use)
# DB_DRIVER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=goaskar
# DB_SSLMODE=disable

# MySQL Configuration (Uncomment to use)
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=goaskar

# JWT Authentication
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECRET
JWT_EXPIRY_HOURS=24
